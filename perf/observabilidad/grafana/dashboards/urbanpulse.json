            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (endpoint) (rate(k6_http_reqs_total{testid=~\"$testid\", endpoint!=\"setup\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
