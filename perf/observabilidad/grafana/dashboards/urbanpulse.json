      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (increase(k6_dropped_iterations_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        }
      ]
    },
