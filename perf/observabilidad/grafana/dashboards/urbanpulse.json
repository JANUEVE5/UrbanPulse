      "description": "Iteraciones que k6 no pudo iniciar porque no quedaban VUs libres: la API no sostiene la tasa pedida.",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
