# =====================================================================
# UrbanPulse — variables de entorno de ejemplo
# Copia este fichero a `.env` (que NO se versiona) y ajusta los valores:
#   cp .env.example .env
# Los valores de abajo son SOLO para desarrollo local. Nunca pongas aquí
# credenciales reales: en staging/producción se inyectan desde el entorno.
# =====================================================================

# --- PostgreSQL (lo usa compose.yaml para levantar la base de datos) ---
POSTGRES_DB=urbanpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# Spring Boot lee estas variables automáticamente y tienen prioridad sobre
# application.properties (relaxed binding).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urbanpulse
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1234
SERVER_PORT=8080

# --- Frontend (Expo) ---
# OJO: Expo solo carga el .env de su propia carpeta. Para usarla, ponla en frontend/.env
# o pásala al arrancar (ver docs/development.md).
# Solo las variables con prefijo EXPO_PUBLIC_ llegan al cliente. No pongas secretos.
# Desde un móvil físico usa la IP de tu ordenador en la red local.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
