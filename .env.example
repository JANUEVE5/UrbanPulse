# =====================================================================
# UrbanPulse — variables de entorno de ejemplo
# Copia este fichero a `.env` (que NO se versiona) y ajusta los valores:
#   cp .env.example .env
# Los valores de abajo son SOLO para desarrollo local. Nunca pongas aquí
# credenciales reales: en staging/producción se inyectan desde el entorno.
# =====================================================================

# --- PostgreSQL (lo usa compose.yaml para levantar la base de datos) ---
POSTGRES_DB=urbanpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# application.properties las lee como ${VARIABLE:valor-por-defecto}. Si no las
# defines, se usan los valores por defecto de desarrollo (iguales a los de aquí).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urbanpulse
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1234
SERVER_PORT=8080
# Orígenes web que pueden llamar a la API (CORS), separados por comas.
# Solo afecta a la app web; Android/iOS no usan CORS. En producción: solo la URL real de la app.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# true para ver en los logs las consultas SQL que ejecuta Hibernate (depuración).
SHOW_SQL=false
# Clave para firmar los tokens JWT (mínimo 32 caracteres). SECRETA: en staging/producción usa un valor
# aleatorio largo, por ejemplo el resultado de `openssl rand -base64 48`, y no lo subas nunca a Git.
JWT_SECRET=urbanpulse-dev-only-secret-change-me-0123456789
# Minutos de validez de cada token
JWT_EXPIRATION_MINUTES=60
# Open Data Málaga: fuente configurada por el context-service y frecuencia de sincronización.
OPENDATA_BASE_URL=https://datosabiertos.malaga.eu
OPENDATA_SYNC_CRON=0 0 4 * * *
# Context-service independiente (PostgreSQL y API en desarrollo local).
CONTEXT_POSTGRES_DB=urbanpulse_context
CONTEXT_POSTGRES_USER=postgres
CONTEXT_POSTGRES_PASSWORD=1234
CONTEXT_POSTGRES_PORT=5433
CONTEXT_DATASOURCE_URL=jdbc:postgresql://localhost:5433/urbanpulse_context
CONTEXT_DATASOURCE_USERNAME=postgres
CONTEXT_DATASOURCE_PASSWORD=1234
CONTEXT_SERVICE_BASE_URL=http://localhost:8082
CONTEXT_ASSET_PROJECTION_ENABLED=true
CONTEXT_ASSET_PROJECTION_CRON=0 */5 * * * *
CONTEXT_SYNC_ENABLED=true
# AEMET OpenData: registra la clave en el portal oficial y mantenla solo en .env.
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api
AEMET_MUNICIPIO_CODIGO=29067
AEMET_STATION_CODE=6156X
AEMET_SYNC_CRON=0 0 * * * *
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_WAIT_SECONDS=60
# Endpoints de Actuator expuestos (ADR-018). /actuator/health y /actuator/prometheus son públicos.
ACTUATOR_EXPOSURE=health,info,metrics,prometheus

# --- Frontend (Expo) ---
# OJO: Expo solo carga el .env de su propia carpeta. Para usarla, ponla en frontend/.env
# o pásala al arrancar (ver docs/development.md).
# Solo las variables con prefijo EXPO_PUBLIC_ llegan al cliente. No pongas secretos.
# Desde un móvil físico usa la IP de tu ordenador en la red local.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
